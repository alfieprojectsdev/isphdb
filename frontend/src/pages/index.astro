---
// src/pages/index.astro
import Database from 'better-sqlite3';
import { evaluateStatus, applyPingBlockedOverride } from '../lib/status.mjs';
import { lookupHopGeo, latencyToColor } from '../lib/geo.mjs';
import hopGeoTable from '../lib/hop-geo.json';
import path from 'path';

// Connect to the SQLite DB generated by the Python daemon
let rawData = [];
let hopRows = [];
try {
  // Use absolute path relative to the current working directory robustly
  const dbPath = process.env.DB_PATH || path.resolve(process.cwd(), '../backend/network_metrics.db');
  console.log(`Attempting to connect to database at: ${dbPath}`);
  const db = new Database(dbPath, { readonly: true });

  // Fetch the last 3 hours of time-series data
  const stmt = db.prepare(`
    SELECT timestamp, target_node, latency_ms
    FROM network_metrics
    WHERE timestamp >= datetime('now', '-3 hours')
    ORDER BY timestamp ASC
  `);
  rawData = stmt.all();

  // Most recent traceroute capture (rows sharing the max timestamp = one capture),
  // shares this single SSR request — no extra API/WebSocket layer.
  hopRows = db.prepare(`
    SELECT hop_index, hop_ip, latency_ms
    FROM traceroute_hops
    WHERE timestamp = (SELECT MAX(timestamp) FROM traceroute_hops)
    ORDER BY hop_index ASC
  `).all();
} catch (error) {
  console.error("Database connection failed. Is the prober running? Path relative to process.cwd():", process.cwd());
  // The prober might not have run yet to create the DB.
}

// Transform data for ECharts: group by target_node
const seriesData = {
  local: [],
  isp_gateway: [],
  external_dns: []
};

rawData.forEach(row => {
  if (seriesData[row.target_node]) {
    // Rows are stored SQLite-canonical UTC ('YYYY-MM-DD HH:MM:SS'). Force UTC parsing
    // (append 'Z') so the time axis is correct; also tolerate legacy ISO ('...T...+00:00').
    const raw = row.timestamp;
    const iso = raw.includes('T') ? raw : raw.replace(' ', 'T') + 'Z';
    const ts = new Date(iso).getTime();
    seriesData[row.target_node].push([ts, row.latency_ms < 0 ? 500 : row.latency_ms]);
  }
});

// Join each captured hop to its geo location; drop unmappable/unknown hops. Points carry
// [lon, lat, latency] plus a precomputed heat color for the map series.
const hopPoints = [];
for (const row of hopRows) {
  const geo = lookupHopGeo(row.hop_ip, hopGeoTable);
  if (!geo) continue;
  hopPoints.push({
    name: geo.label,
    ip: row.hop_ip,
    value: [geo.lon, geo.lat, row.latency_ms],
    color: latencyToColor(row.latency_ms),
  });
}

const localStatus = evaluateStatus(seriesData.local);
const ispStatus = evaluateStatus(seriesData.isp_gateway);
const dnsStatus = evaluateStatus(seriesData.external_dns);

const overrides = applyPingBlockedOverride(localStatus, ispStatus, dnsStatus);
Object.assign(localStatus, overrides.local);
Object.assign(ispStatus, overrides.isp);

// Overall network interpretation
let overallStateMsg = "All Systems Nominal. Your network is performing normally.";
let overallStateColor = "#3fb950"; // Green

if (localStatus.status === 'bad' || localStatus.status === 'offline') {
  overallStateMsg = "Critical Local Network Issue! Check your Wi-Fi router or LAN cables.";
  overallStateColor = "#f85149"; // Red
} else if (ispStatus.status === 'bad' || ispStatus.status === 'offline') {
  overallStateMsg = "ISP Gateway Congestion! The bottleneck is between your house and the ISP.";
  overallStateColor = "#d29922"; // Yellow
} else if (dnsStatus.status === 'bad' || dnsStatus.status === 'offline') {
  overallStateMsg = "Widespread Internet Routing Issue! Local and ISP connections are fine, but the broader internet backbone is struggling.";
  overallStateColor = "#f85149"; // Red
} else if (ispStatus.status === 'warn' || dnsStatus.status === 'warn') {
  overallStateMsg = "Minor Network Degradation detected. Connections are active but slower than usual.";
  overallStateColor = "#d29922"; // Yellow
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0">
    <meta name="theme-color" content="#0d1117">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>ISP Health Dashboard</title>
    <script is:inline src="https://cdn.jsdelivr.net/npm/echarts@5.5.0/dist/echarts.min.js"></script>
    <style>
      :root {
        --bg-color: #0d1117;
        --card-bg: #161b22;
        --text-color: #c9d1d9;
        --heading-color: #f0f6fc;
        --accent: #58a6ff;
        --font-mono: ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", Menlo, monospace;
      }
      body { 
        font-family: system-ui, -apple-system, sans-serif; 
        background: var(--bg-color); 
        color: var(--text-color); 
        margin: 0;
        padding: 2rem; 
      }
      .container {
        max-width: 1200px;
        margin: 0 auto;
      }
      header {
        margin-bottom: 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      h1 {
        color: var(--heading-color);
        margin: 0;
        font-weight: 600;
        letter-spacing: -0.025em;
      }
      .status {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.875rem;
        background: rgba(88, 166, 255, 0.1);
        color: var(--accent);
        padding: 0.5rem 1rem;
        border-radius: 9999px;
      }
      .pulse {
        width: 8px;
        height: 8px;
        background-color: var(--accent);
        border-radius: 50%;
        animation: pulse 2s infinite;
      }
      @keyframes pulse {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(88, 166, 255, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(88, 166, 255, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(88, 166, 255, 0); }
      }
      .legend-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
      }
      .legend-item {
        background: var(--card-bg);
        border: 1px solid #30363d;
        border-radius: 8px;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }
      .legend-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
        color: #f0f6fc;
      }
      .legend-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
      }
      .legend-desc {
        font-size: 0.875rem;
        color: #8b949e;
        line-height: 1.4;
      }
      .summary-banner {
        background: var(--card-bg);
        border: 1px solid #30363d;
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 2rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        border-left: 6px solid;
      }
      .summary-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: #f0f6fc;
      }
      .quick-stats {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .stat-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        border-radius: 9999px;
        font-size: 0.875rem;
        font-weight: 600;
        background: rgba(255,255,255,0.05);
        border: 1px solid #30363d;
      }
      .badge-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
      }
      #chart-container { 
        background: var(--card-bg); 
        border-radius: 12px; 
        padding: 1.5rem; 
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        border: 1px solid #30363d;
      }
      #chart {
        width: 100%;
        height: 600px;
      }
      #geo-container {
        background: var(--card-bg);
        border-radius: 12px;
        padding: 1.5rem;
        margin-top: 2rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        border: 1px solid #30363d;
      }
      .geo-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #f0f6fc;
        margin: 0 0 0.25rem;
      }
      .geo-sub {
        font-size: 0.875rem;
        color: #8b949e;
        margin: 0 0 1rem;
      }
      #geo-chart {
        width: 100%;
        height: 500px;
      }
      .error-state {
        text-align: center;
        padding: 4rem;
        background: var(--card-bg);
        border-radius: 12px;
        border: 1px solid #30363d;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <header>
        <h1>Network Health Dashboard</h1>
        <div class="status">
          <div class="pulse"></div>
          Monitoring Last 3 Hours
        </div>
      </header>

      {rawData.length > 0 && (
        <div class="summary-banner" style={`border-left-color: ${overallStateColor}`}>
          <div class="summary-title">{overallStateMsg}</div>
          <div class="quick-stats">
            <div class="stat-badge">
              <div class="badge-dot" style={`background-color: ${localStatus.status === 'good' ? '#3fb950' : localStatus.status === 'warn' ? '#d29922' : '#f85149'}`}></div>
              Home Router Phase: {localStatus.msg}
            </div>
            <div class="stat-badge">
              <div class="badge-dot" style={`background-color: ${ispStatus.status === 'good' ? '#3fb950' : ispStatus.status === 'warn' ? '#d29922' : '#f85149'}`}></div>
              ISP Gateway Phase: {ispStatus.msg}
            </div>
            <div class="stat-badge">
              <div class="badge-dot" style={`background-color: ${dnsStatus.status === 'good' ? '#3fb950' : dnsStatus.status === 'warn' ? '#d29922' : '#f85149'}`}></div>
              Global Internet Phase: {dnsStatus.msg}
            </div>
          </div>
        </div>
      )}
      
      <div class="legend-container">
        <div class="legend-item">
          <div class="legend-header">
            <div class="legend-dot" style="background-color: #3fb950"></div>
            Local Router (<span style="color: #3fb950">Green</span>)
          </div>
          <div class="legend-desc">Your local home network Wi-Fi or LAN connection. Latency here should consistently be less than 5ms.</div>
        </div>
        <div class="legend-item">
          <div class="legend-header">
            <div class="legend-dot" style="background-color: #d29922"></div>
            ISP Gateway (<span style="color: #d29922">Yellow</span>)
          </div>
          <div class="legend-desc">The first hop connecting your home to your Internet Service Provider. Spikes here indicate neighborhood cable/fiber congestion.</div>
        </div>
        <div class="legend-item">
          <div class="legend-header">
            <div class="legend-dot" style="background-color: #f85149"></div>
            External DNS (<span style="color: #f85149">Red</span>)
          </div>
          <div class="legend-desc">Wider internet connectivity (1.1.1.1). If this spikes while your ISP Gateway stays low, the broader internet routing backbone is experiencing issues.</div>
        </div>
      </div>

      
      {rawData.length === 0 ? (
        <div class="error-state">
          <h2>No telemetry data found.</h2>
          <p>Ensure the background Python prober daemon is running and has populated the database.</p>
        </div>
      ) : (
        <div id="chart-container">
          <div id="chart"></div>
        </div>
      )}

      {hopPoints.length > 0 && (
        <div id="geo-container">
          <div class="geo-title">Route Geography</div>
          <div class="geo-sub">Latest traceroute to 1.1.1.1 — geolocatable public hops, colored by latency.</div>
          <div id="geo-chart"></div>
        </div>
      )}
    </div>

    {rawData.length > 0 && (
      <script define:vars={{ seriesData }}>
        const chartDom = document.getElementById('chart');
        if (chartDom) {
          const myChart = echarts.init(chartDom, 'dark', { renderer: 'canvas' });

          // Apply modern dark theme overrides to closely match our CSS variables
          const option = {
            backgroundColor: 'transparent', // Let CSS handle the background
            tooltip: { 
              trigger: 'axis',
              backgroundColor: 'rgba(22, 27, 34, 0.9)',
              borderColor: '#30363d',
              textStyle: { color: '#c9d1d9' }
            },
            legend: { 
              data: ['Local Router', 'ISP Gateway', 'External DNS (1.1.1.1)'],
              textStyle: { color: '#c9d1d9' },
              top: 10
            },
            grid: {
              left: '3%',
              right: '4%',
              bottom: '3%',
              containLabel: true
            },
            xAxis: {
              type: 'time',
              axisLine: { lineStyle: { color: '#30363d' } },
              splitLine: { show: false },
            },
            yAxis: { 
              type: 'value', 
              name: 'Latency (ms)',
              nameTextStyle: { color: '#8b949e' },
              axisLine: { show: false },
              splitLine: { lineStyle: { color: '#30363d', type: 'dashed' } },
            },
            series: [
              { 
                name: 'Local Router', 
                type: 'line', 
                data: seriesData.local, 
                smooth: 0.3, 
                showSymbol: false,
                color: '#3fb950', // Success green
                lineStyle: { width: 3 },
                areaStyle: {
                  color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
                    { offset: 0, color: 'rgba(63, 185, 80, 0.4)' },
                    { offset: 1, color: 'rgba(63, 185, 80, 0.0)' }
                  ])
                }
              },
              { 
                name: 'ISP Gateway', 
                type: 'line', 
                data: seriesData.isp_gateway, 
                smooth: 0.3, 
                showSymbol: false,
                color: '#d29922', // Warning yellow
                lineStyle: { width: 3 },
                areaStyle: {
                  color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
                    { offset: 0, color: 'rgba(210, 153, 34, 0.4)' },
                    { offset: 1, color: 'rgba(210, 153, 34, 0.0)' }
                  ])
                }
              },
              { 
                name: 'External DNS (1.1.1.1)', 
                type: 'line', 
                data: seriesData.external_dns, 
                smooth: 0.3, 
                showSymbol: false,
                color: '#f85149', // Danger red
                lineStyle: { width: 3 },
                areaStyle: {
                  color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
                    { offset: 0, color: 'rgba(248, 81, 73, 0.4)' },
                    { offset: 1, color: 'rgba(248, 81, 73, 0.0)' }
                  ])
                }
              }
            ]
          };

          myChart.setOption(option);
          
          window.addEventListener('resize', () => {
            myChart.resize();
          });
        }
        
        // Auto-refresh the page every 30 seconds to fetch new SQLite data
        setTimeout(() => window.location.reload(), 30000);
      </script>
    )}

    {hopPoints.length > 0 && (
      <script define:vars={{ hopPoints }}>
        (async () => {
          const el = document.getElementById('geo-chart');
          if (!el || !hopPoints.length) return;

          // Load the Philippines outline once, then register it for the geo coordinate system.
          let geojson;
          try {
            geojson = await (await fetch('/philippines.geo.json')).json();
          } catch (e) {
            console.error('Geo map load failed:', e);
            return;
          }
          echarts.registerMap('philippines', geojson);

          const map = echarts.init(el, 'dark', { renderer: 'canvas' });
          const scatter = hopPoints.map(h => ({
            name: h.name,
            value: h.value,
            itemStyle: { color: h.color }
          }));
          const pathCoords = hopPoints.map(h => [h.value[0], h.value[1]]);
          const lines = [];
          for (let i = 1; i < pathCoords.length; i++) {
            lines.push({ coords: [pathCoords[i - 1], pathCoords[i]] });
          }

          map.setOption({
            backgroundColor: 'transparent',
            tooltip: {
              trigger: 'item',
              backgroundColor: 'rgba(22, 27, 34, 0.9)',
              borderColor: '#30363d',
              textStyle: { color: '#c9d1d9' },
              formatter: (p) => {
                if (p.seriesType !== 'effectScatter') return '';
                const lm = p.value[2];
                return `${p.name}<br/>${lm < 0 ? 'unreachable' : lm.toFixed(1) + ' ms'}`;
              }
            },
            geo: {
              map: 'philippines',
              roam: true,
              itemStyle: { areaColor: '#161b22', borderColor: '#30363d' },
              emphasis: { itemStyle: { areaColor: '#1f2731' }, label: { show: false } }
            },
            series: [
              {
                name: 'Route',
                type: 'lines',
                coordinateSystem: 'geo',
                data: lines,
                lineStyle: { color: '#58a6ff', width: 1.5, opacity: 0.6, curveness: 0.2 },
                z: 1
              },
              {
                name: 'Hops',
                type: 'effectScatter',
                coordinateSystem: 'geo',
                data: scatter,
                symbolSize: 12,
                rippleEffect: { scale: 2.5 },
                // Hops cluster tightly (all Metro Manila here), so always-on labels overlap.
                // Show the label only on hover; the tooltip carries IP + latency.
                label: { show: false },
                emphasis: { label: { show: true, formatter: '{b}', position: 'right', color: '#c9d1d9', fontSize: 11 } },
                z: 2
              }
            ]
          });

          window.addEventListener('resize', () => map.resize());
        })();
      </script>
    )}
  </body>
</html>
