---
// src/pages/index.astro
import Database from 'better-sqlite3';
import { evaluateStatus, applyPingBlockedOverride } from '../lib/status.mjs';
import { lookupHopGeo, tierColor, latencyToColor } from '../lib/geo.mjs';
import hopGeoTable from '../lib/hop-geo.json';
import path from 'path';

// Connect to the SQLite DB generated by the Python daemon
let rawData = [];
let hopRows = [];
try {
  // Use absolute path relative to the current working directory robustly
  const dbPath = process.env.DB_PATH || path.resolve(process.cwd(), '../backend/network_metrics.db');
  console.log(`Attempting to connect to database at: ${dbPath}`);
  const db = new Database(dbPath, { readonly: true });

  // Fetch the last 3 hours of time-series data
  const stmt = db.prepare(`
    SELECT timestamp, target_node, latency_ms
    FROM network_metrics
    WHERE timestamp >= datetime('now', '-3 hours')
    ORDER BY timestamp ASC
  `);
  rawData = stmt.all();

  // Most recent traceroute capture (rows sharing the max timestamp = one capture),
  // shares this single SSR request — no extra API/WebSocket layer.
  hopRows = db.prepare(`
    SELECT hop_index, hop_ip, latency_ms
    FROM traceroute_hops
    WHERE timestamp = (SELECT MAX(timestamp) FROM traceroute_hops)
    ORDER BY hop_index ASC
  `).all();
} catch (error) {
  console.error("Database connection failed. Is the prober running? Path relative to process.cwd():", process.cwd());
  // The prober might not have run yet to create the DB.
}

// Transform data for ECharts: group by target_node
const seriesData = {
  local: [],
  isp_gateway: [],
  external_dns: []
};

rawData.forEach(row => {
  if (seriesData[row.target_node]) {
    // Rows are stored SQLite-canonical UTC ('YYYY-MM-DD HH:MM:SS'). Force UTC parsing
    // (append 'Z') so the time axis is correct; also tolerate legacy ISO ('...T...+00:00').
    const raw = row.timestamp;
    const iso = raw.includes('T') ? raw : raw.replace(' ', 'T') + 'Z';
    const ts = new Date(iso).getTime();
    seriesData[row.target_node].push([ts, row.latency_ms < 0 ? 500 : row.latency_ms]);
  }
});

// Build the Route Ladder: an ordered home -> internet path. Unlike a geo map, it can show
// the private hops (local router, ISP gateway) since it needs no coordinates — those two
// rungs reuse the live latency of the monitored targets. The middle rungs are the captured
// public traceroute hops (labeled/tiered via the curated table); the last rung is the
// destination. Latency of -1 or the 500 sentinel renders as "timeout".
const lastVal = (arr) => (arr.length ? arr[arr.length - 1][1] : null);
const localMs = lastVal(seriesData.local);
const ispMs = lastVal(seriesData.isp_gateway);
const dnsMs = lastVal(seriesData.external_dns);

const midRungs = [];
for (const row of hopRows) {
  const geo = lookupHopGeo(row.hop_ip, hopGeoTable);
  if (!geo) continue;                    // skip uncurated public hops (rare)
  if (row.hop_ip === '1.1.1.1') continue; // destination is the final rung, not a mid hop
  midRungs.push({ label: geo.label, sub: row.hop_ip, tier: geo.tier || 'external', ms: row.latency_ms });
}

const ladderRaw = [];
if (localMs !== null) ladderRaw.push({ label: 'Local Router', sub: 'Your LAN / Wi-Fi', tier: 'lan', ms: localMs });
if (ispMs !== null) ladderRaw.push({ label: 'ISP Gateway', sub: 'Physical ISP line', tier: 'isp', ms: ispMs });
ladderRaw.push(...midRungs);
if (dnsMs !== null) ladderRaw.push({ label: 'Internet', sub: '1.1.1.1 · Cloudflare DNS', tier: 'external', ms: dnsMs });

const ladder = ladderRaw.map(r => {
  const down = r.ms === null || r.ms < 0 || r.ms >= 500;
  return {
    label: r.label,
    sub: r.sub,
    dotColor: tierColor(r.tier),
    latLabel: r.ms === null ? '—' : (down ? 'timeout' : `${r.ms.toFixed(1)} ms`),
    latColor: r.ms === null ? '#8b949e' : latencyToColor(down ? 500 : r.ms),
  };
});

// Whether any monitored target currently shows the failure sentinel (500). Drives the red
// "offline" marker line on the chart; only shown when relevant so it never blows up the axis.
const hasFailure = Object.values(seriesData).some(arr => arr.some(pt => pt[1] >= 500));

const localStatus = evaluateStatus(seriesData.local);
const ispStatus = evaluateStatus(seriesData.isp_gateway);
const dnsStatus = evaluateStatus(seriesData.external_dns);

const overrides = applyPingBlockedOverride(localStatus, ispStatus, dnsStatus);
Object.assign(localStatus, overrides.local);
Object.assign(ispStatus, overrides.isp);

// Overall network interpretation. The long message is shown on hover (title); the short
// label heads the status rail beside the chart.
let overallStateMsg = "All Systems Nominal. Your network is performing normally.";
let overallStateShort = "All Nominal";
let overallStateColor = "#3fb950"; // Green

if (localStatus.status === 'bad' || localStatus.status === 'offline') {
  overallStateMsg = "Critical Local Network Issue! Check your Wi-Fi router or LAN cables.";
  overallStateShort = "Local Network Issue";
  overallStateColor = "#f85149"; // Red
} else if (ispStatus.status === 'bad' || ispStatus.status === 'offline') {
  overallStateMsg = "ISP Gateway Congestion! The bottleneck is between your house and the ISP.";
  overallStateShort = "ISP Congestion";
  overallStateColor = "#d29922"; // Yellow
} else if (dnsStatus.status === 'bad' || dnsStatus.status === 'offline') {
  overallStateMsg = "Widespread Internet Routing Issue! Local and ISP connections are fine, but the broader internet backbone is struggling.";
  overallStateShort = "Internet Routing Issue";
  overallStateColor = "#f85149"; // Red
} else if (ispStatus.status === 'warn' || dnsStatus.status === 'warn') {
  overallStateMsg = "Minor Network Degradation detected. Connections are active but slower than usual.";
  overallStateShort = "Minor Degradation";
  overallStateColor = "#d29922"; // Yellow
}

// Per-layer status color helper for the rail tiles.
const statusColor = (s) => (s === 'good' ? '#3fb950' : s === 'warn' ? '#d29922' : '#f85149');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0">
    <meta name="theme-color" content="#0d1117">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>ISP Health Dashboard</title>
    <script is:inline src="https://cdn.jsdelivr.net/npm/echarts@5.5.0/dist/echarts.min.js"></script>
    <style>
      :root {
        --bg-color: #0d1117;
        --card-bg: #161b22;
        --text-color: #c9d1d9;
        --heading-color: #f0f6fc;
        --accent: #58a6ff;
        --font-mono: ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", Menlo, monospace;
      }
      body { 
        font-family: system-ui, -apple-system, sans-serif; 
        background: var(--bg-color); 
        color: var(--text-color); 
        margin: 0;
        padding: 2rem; 
      }
      .container {
        max-width: 1200px;
        margin: 0 auto;
      }
      header {
        margin-bottom: 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      h1 {
        color: var(--heading-color);
        margin: 0;
        font-weight: 600;
        letter-spacing: -0.025em;
      }
      .status {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.875rem;
        background: rgba(88, 166, 255, 0.1);
        color: var(--accent);
        padding: 0.5rem 1rem;
        border-radius: 9999px;
      }
      .pulse {
        width: 8px;
        height: 8px;
        background-color: var(--accent);
        border-radius: 50%;
        animation: pulse 2s infinite;
      }
      @keyframes pulse {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(88, 166, 255, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(88, 166, 255, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(88, 166, 255, 0); }
      }
      .legend-strip {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        margin-bottom: 1.5rem;
        padding: 0 0.25rem;
      }
      .legend-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font-size: 0.85rem;
        color: #8b949e;
        cursor: help;
      }
      .legend-dot {
        width: 11px;
        height: 11px;
        border-radius: 50%;
        flex-shrink: 0;
      }
      /* Chart with a compact status rail on the right; rail drops below the chart on
         narrow screens. Replaces the old full-width summary banner. */
      .content-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 210px;
        gap: 1.5rem;
        align-items: stretch;
      }
      @media (max-width: 820px) {
        .content-row { grid-template-columns: 1fr; }
        .status-rail { flex-direction: row !important; flex-wrap: wrap; }
        .status-tile { flex: 1 1 150px; }
      }
      .status-rail {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }
      .status-tile {
        background: var(--card-bg);
        border: 1px solid #30363d;
        border-radius: 8px;
        padding: 0.7rem 0.85rem;
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
      }
      .status-tile.overall { border-left: 4px solid; }
      .st-head {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: #8b949e;
      }
      .st-dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }
      .st-msg { font-size: 0.9rem; font-weight: 600; color: #f0f6fc; }
      #chart-container, #ladder-container {
        background: var(--card-bg);
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        border: 1px solid #30363d;
      }
      #chart {
        width: 100%;
        height: 380px;
      }
      /* Landscape route ladder sits directly below the chart — short, so no scroll cost. */
      #ladder-container {
        margin-top: 1.5rem;
      }
      .geo-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #f0f6fc;
        margin: 0 0 0.25rem;
      }
      .geo-sub {
        font-size: 0.875rem;
        color: #8b949e;
        margin: 0 0 1.25rem;
      }
      /* Horizontal home -> internet ladder. Rungs flex evenly and wrap on narrow screens;
         a rail line connects them via ::before/::after around each node. */
      .ladder {
        display: flex;
        flex-wrap: wrap;
        row-gap: 1.25rem;
      }
      .rung {
        flex: 1 1 90px;
        min-width: 84px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }
      .rung .rail {
        position: relative;
        width: 100%;
        height: 20px;
        display: flex;
        justify-content: center;
        align-items: center;
      }
      .rung .rail::before, .rung .rail::after {
        content: '';
        position: absolute;
        top: 50%;
        height: 2px;
        width: 50%;
        background: #30363d;
      }
      .rung .rail::before { left: 0; }
      .rung .rail::after { right: 0; }
      .rung:first-child .rail::before { display: none; }
      .rung:last-child .rail::after { display: none; }
      .node {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        z-index: 1;
        box-shadow: 0 0 0 3px var(--card-bg);
      }
      .rung-label {
        font-size: 0.8rem;
        font-weight: 600;
        color: #c9d1d9;
        margin-top: 0.5rem;
      }
      .rung-sub {
        font-size: 0.7rem;
        color: #8b949e;
        word-break: break-all;
        line-height: 1.3;
        padding: 0 0.25rem;
      }
      .rung-lat {
        font-size: 0.8rem;
        font-weight: 600;
        margin-top: 0.3rem;
      }
      .error-state {
        text-align: center;
        padding: 4rem;
        background: var(--card-bg);
        border-radius: 12px;
        border: 1px solid #30363d;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <header>
        <h1>Network Health Dashboard</h1>
        <div class="status">
          <div class="pulse"></div>
          Monitoring Last 3 Hours
        </div>
      </header>

      <div class="legend-strip">
        <span class="legend-chip" title="Your local home network Wi-Fi or LAN connection. Latency here should consistently be under 5ms.">
          <span class="legend-dot" style="background-color: #58a6ff"></span>Local Router
        </span>
        <span class="legend-chip" title="The first hop connecting your home to your ISP. Spikes here indicate neighborhood cable/fiber congestion.">
          <span class="legend-dot" style="background-color: #a371f7"></span>ISP Gateway
        </span>
        <span class="legend-chip" title="Wider internet connectivity (1.1.1.1). If this spikes while the ISP Gateway stays low, the broader internet backbone is struggling.">
          <span class="legend-dot" style="background-color: #39c5cf"></span>External DNS
        </span>
      </div>

      {rawData.length === 0 ? (
        <div class="error-state">
          <h2>No telemetry data found.</h2>
          <p>Ensure the background Python prober daemon is running and has populated the database.</p>
        </div>
      ) : (
        <>
          <div class="content-row">
            <div id="chart-container">
              <div id="chart"></div>
            </div>
            <aside class="status-rail">
              <div class="status-tile overall" style={`border-left-color: ${overallStateColor}`} title={overallStateMsg}>
                <div class="st-head"><span class="st-dot" style={`background-color: ${overallStateColor}`}></span>Overall</div>
                <div class="st-msg">{overallStateShort}</div>
              </div>
              <div class="status-tile">
                <div class="st-head"><span class="st-dot" style={`background-color: ${statusColor(localStatus.status)}`}></span>Home Router</div>
                <div class="st-msg">{localStatus.msg}</div>
              </div>
              <div class="status-tile">
                <div class="st-head"><span class="st-dot" style={`background-color: ${statusColor(ispStatus.status)}`}></span>ISP Gateway</div>
                <div class="st-msg">{ispStatus.msg}</div>
              </div>
              <div class="status-tile">
                <div class="st-head"><span class="st-dot" style={`background-color: ${statusColor(dnsStatus.status)}`}></span>Internet</div>
                <div class="st-msg">{dnsStatus.msg}</div>
              </div>
            </aside>
          </div>

          {ladder.length > 0 && (
            <div id="ladder-container">
              <div class="geo-title">Route Ladder</div>
              <div class="geo-sub">Latest hop-by-hop path from your home to the internet, by network layer.</div>
              <div class="ladder">
                {ladder.map((r) => (
                  <div class="rung">
                    <div class="rail"><span class="node" style={`background-color: ${r.dotColor}`}></span></div>
                    <div class="rung-label">{r.label}</div>
                    <div class="rung-sub">{r.sub}</div>
                    <div class="rung-lat" style={`color: ${r.latColor}`}>{r.latLabel}</div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </>
      )}
    </div>

    {rawData.length > 0 && (
      <script define:vars={{ seriesData, hasFailure }}>
        const chartDom = document.getElementById('chart');
        if (chartDom) {
          const myChart = echarts.init(chartDom, 'dark', { renderer: 'canvas' });

          // Apply modern dark theme overrides to closely match our CSS variables
          const option = {
            backgroundColor: 'transparent', // Let CSS handle the background
            tooltip: { 
              trigger: 'axis',
              backgroundColor: 'rgba(22, 27, 34, 0.9)',
              borderColor: '#30363d',
              textStyle: { color: '#c9d1d9' }
            },
            legend: { 
              data: ['Local Router', 'ISP Gateway', 'External DNS (1.1.1.1)'],
              textStyle: { color: '#c9d1d9' },
              top: 10
            },
            grid: {
              left: '3%',
              right: '4%',
              bottom: '3%',
              containLabel: true
            },
            xAxis: {
              type: 'time',
              axisLine: { lineStyle: { color: '#30363d' } },
              splitLine: { show: false },
            },
            yAxis: {
              type: 'value',
              name: 'Latency (ms)',
              nameTextStyle: { color: '#8b949e' },
              axisLine: { show: false },
              splitLine: { lineStyle: { color: '#30363d', type: 'dashed' } },
              // Pin the top to the sentinel only when a failure is present, so the red
              // marker line sits at the ceiling. Otherwise let the axis auto-fit the real
              // latency range (a 500 line would otherwise flatten normal variation).
              max: hasFailure ? 520 : null,
            },
            series: [
              {
                name: 'Local Router',
                type: 'line',
                data: seriesData.local,
                smooth: 0.3,
                showSymbol: false,
                color: '#58a6ff', // Categorical (identity, not status): blue
                lineStyle: { width: 3 },
                // The failure sentinel: -1.0 pings map to 500. Draw a single red reference
                // line at that level (on this series only; it spans the whole plot) so
                // dropped-packet spikes are unmistakable. Hidden when nothing has failed.
                markLine: hasFailure ? {
                  silent: true,
                  symbol: 'none',
                  data: [{ yAxis: 500 }],
                  lineStyle: { color: '#f85149', type: 'dashed', width: 1.5 },
                  label: { formatter: 'Offline (packet loss)', color: '#f85149', position: 'insideEndTop' }
                } : undefined,
                areaStyle: {
                  color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
                    { offset: 0, color: 'rgba(88, 166, 255, 0.35)' },
                    { offset: 1, color: 'rgba(88, 166, 255, 0.0)' }
                  ])
                }
              },
              { 
                name: 'ISP Gateway', 
                type: 'line', 
                data: seriesData.isp_gateway, 
                smooth: 0.3, 
                showSymbol: false,
                color: '#a371f7', // Categorical (identity, not status): purple
                lineStyle: { width: 3 },
                areaStyle: {
                  color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
                    { offset: 0, color: 'rgba(163, 113, 247, 0.35)' },
                    { offset: 1, color: 'rgba(163, 113, 247, 0.0)' }
                  ])
                }
              },
              { 
                name: 'External DNS (1.1.1.1)', 
                type: 'line', 
                data: seriesData.external_dns, 
                smooth: 0.3, 
                showSymbol: false,
                color: '#39c5cf', // Categorical (identity, not status): teal
                lineStyle: { width: 3 },
                areaStyle: {
                  color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
                    { offset: 0, color: 'rgba(57, 197, 207, 0.35)' },
                    { offset: 1, color: 'rgba(57, 197, 207, 0.0)' }
                  ])
                }
              }
            ]
          };

          myChart.setOption(option);
          
          window.addEventListener('resize', () => {
            myChart.resize();
          });
        }
        
        // Auto-refresh the page every 30 seconds to fetch new SQLite data
        setTimeout(() => window.location.reload(), 30000);
      </script>
    )}
  </body>
</html>
